+struct WaitAnyAwaitable : BaseAwaitable {
+  std::vector<int> fds_;
+  uint32_t event_mask_;
+  uint64_t timeout_ns_;
+  mutable int result_ = -1;
+
+  WaitAnyAwaitable(Coroutine* coroutine, Scheduler* scheduler,
+                   std::vector<int> fds, uint32_t event_mask,
+                   uint64_t timeout_ns)
+    : BaseAwaitable(coroutine, scheduler), fds_(std::move(fds)),
+      event_mask_(event_mask), timeout_ns_(timeout_ns) {}
+
+  bool await_ready() const noexcept {
+    if (coroutine_ && scheduler_) {
+      int result = scheduler_->PollFds(fds_, event_mask_);
+      if (result != -1) {
+        result_ = result;
+        return true;
+      }
+    }
+    return false;
+  }
+
+  void await_suspend(std::coroutine_handle<> handle) const {
+    BaseAwaitable::await_suspend(handle);
+    if (coroutine_ && scheduler_) {
+      scheduler_->WaitForFds(coroutine_, fds_, event_mask_, timeout_ns_);
+    }
+  }
+
+  int await_resume() const {
+    if (coroutine_ && coroutine_->IsAborted()) {
+      throw AbortException();
+    }
+    if (result_ != -1) {
+      return result_;
+    }
+    if (coroutine_) {
+      return coroutine_->GetWaitResult();
+    }
+    return -1;
+  }
+};
