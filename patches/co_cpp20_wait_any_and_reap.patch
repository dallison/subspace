+int Scheduler::PollFds(const std::vector<int>& fds, uint32_t event_mask) {
+  for (int fd : fds) {
+    if (PollFd(fd, event_mask) == fd) return fd;
+  }
+  return -1;
+}
+
+void Scheduler::DetachExtraFds(Coroutine* coroutine) {
+  auto extra_it = extra_fds_.find(coroutine);
+  if (extra_it == extra_fds_.end()) return;
+  for (int fd : extra_it->second) {
+    auto waiting_it = waiting_fds_.find(fd);
+    if (waiting_it == waiting_fds_.end()) continue;
+    auto& list = waiting_it->second;
+    list.erase(std::remove(list.begin(), list.end(), coroutine), list.end());
+    if (list.empty()) {
+      waiting_fds_.erase(waiting_it);
+#if CO_POLL_MODE == CO_POLL_EPOLL
+      if (epoll_fd_ != -1) {
+        epoll_ctl(epoll_fd_, EPOLL_CTL_DEL, fd, nullptr);
+      }
+#endif
+    }
+  }
+  extra_fds_.erase(extra_it);
+}
+
+void Scheduler::ReapCoroutine(Coroutine* coroutine) {
+  // A coroutine can be queued more than once (a wakeup racing an Abort).
+  ready_queue_.erase(
+      std::remove(ready_queue_.begin(), ready_queue_.end(), coroutine),
+      ready_queue_.end());
+  auto it = std::find_if(
+      coroutines_.begin(), coroutines_.end(),
+      [coroutine](const std::unique_ptr<Coroutine>& c) {
+        return c.get() == coroutine;
+      });
+  if (it != coroutines_.end()) {
+    coroutines_.erase(it);
+  }
+}
