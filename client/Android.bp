cc_library_shared {
    name: "libsubspace_client",
    defaults: ["subspace_defaults"],
    srcs: [
        "client.cc",
        "client_channel.cc",
        "message.cc",
        "publisher.cc",
        "subscriber.cc",
    ],
    export_include_dirs: ["."],
    include_dirs: ["external/subspace"],
    static_libs: [
        "libsubspace_crc32",
        "libsubspace_common",
        "libsubspace_proto",
        "libsubspace_phaser",
        "libcoroutines",
        "libcpp_toolbelt",
        "libabsl",
    ],
    export_static_lib_headers: ["libsubspace_phaser"],
    shared_libs: [
        "libprotobuf-cpp-full",
        "liblog",
    ],
}
