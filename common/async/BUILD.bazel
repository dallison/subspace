package(default_visibility = ["//visibility:public"])

load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

# The async abstraction layer.  One macro (SUBSPACE_CORO_BACKEND) selects
# between the `co` coroutine backend (default), the Boost.Asio backend and the
# C++20 coroutine backend (co20).  The macro is propagated to dependents via
# `defines` because the headers (context.h / socket.h) are included by the
# server and client translation units and must see the same backend
# selection.  It is always set, even for co, because some dependents
# (co20_rpc) compile as C++20 in a C++17 build and context.h would otherwise
# choose co20 for them.
cc_library(
    name = "async",
    srcs = [
        "byte_stream.cc",
        "frame_pool.cc",
        "socket.cc",
        "wait.cc",
    ],
    hdrs = [
        "byte_stream.h",
        "context.h",
        "frame_pool.h",
        "mtls.h",
        "runtime.h",
        "socket.h",
        "task.h",
        "wait.h",
    ],
    defines = select({
        # Values from context.h.
        "//:coro_backend_asio": ["SUBSPACE_CORO_BACKEND=2"],
        "//:coro_backend_co20": ["SUBSPACE_CORO_BACKEND=3"],
        "//conditions:default": ["SUBSPACE_CORO_BACKEND=1"],
    }) + select({
        "//:mtls_enabled": ["SUBSPACE_ENABLE_MTLS=1"],
        "//conditions:default": ["SUBSPACE_ENABLE_MTLS=0"],
    }),
    deps = [
        "//common:coroutine_stack",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings:str_format",
        "@coroutines//co:co",
        "@cpp_toolbelt//toolbelt",
    ] + select({
        "//:coro_backend_asio": [
            "@boost.asio//:boost.asio",
            "@boost.context//:boost.context",
            "@boost.coroutine//:boost.coroutine",
        ],
        "//:coro_backend_co20": ["@coroutines//co:co_cpp20"],
        "//conditions:default": [],
    }) + select({
        "//:mtls_enabled": [
            "@boringssl//:crypto",
            "@boringssl//:ssl",
        ],
        "//conditions:default": [],
    }),
)

cc_library(
    name = "mtls_test_certs",
    testonly = True,
    hdrs = ["mtls_test_certs.h"],
)

cc_test(
    name = "mtls_test",
    size = "small",
    srcs = ["mtls_test.cc"],
    deps = [
        ":async",
        ":mtls_test_certs",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:status_matchers",
        "@googletest//:gtest_main",
    ] + select({
        "//:mtls_enabled": [
            "@boringssl//:crypto",
            "@boringssl//:ssl",
        ],
        "//conditions:default": [],
    }) + select({
        "//:coro_backend_asio": [
            "@boost.asio//:boost.asio",
        ],
        "//conditions:default": [],
    }),
)

cc_test(
    name = "async_test",
    size = "small",
    srcs = ["async_test.cc"],
    deps = [
        ":async",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:status_matchers",
        "@coroutines//co:co",
        "@googletest//:gtest_main",
    ] + select({
        "//:coro_backend_asio": [
            "@boost.asio//:boost.asio",
            "@boost.coroutine//:boost.coroutine",
        ],
        "//conditions:default": [],
    }),
)
