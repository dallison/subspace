+void Scheduler::WaitForFds(Coroutine* coroutine, const std::vector<int>& fds,
+                           uint32_t event_mask, uint64_t timeout_ns) {
+  if (!coroutine) return;
+  if (fds.empty()) {
+    ScheduleCoroutine(coroutine);
+    return;
+  }
+  int ready = PollFds(fds, event_mask);
+  if (ready != -1) {
+    coroutine->SetWaitResult(ready);
+    coroutine->SetState(Coroutine::State::kReady);
+    ready_queue_.push_back(coroutine);
+    TriggerInterrupt();
+    return;
+  }
+
+  // The first fd takes the single-fd path, which also registers the interrupt
+  // fd and the timeout.
+  WaitForFd(coroutine, fds[0], event_mask, timeout_ns);
+  if (coroutine->GetState() != Coroutine::State::kWaiting) {
+    return;
+  }
+
+  std::vector<int>& extra = extra_fds_[coroutine];
+  for (size_t i = 1; i < fds.size(); i++) {
+    int fd = fds[i];
+    if (fd == fds[0] ||
+        std::find(extra.begin(), extra.end(), fd) != extra.end()) {
+      continue;
+    }
+    [[maybe_unused]] bool fd_already_tracked = waiting_fds_.count(fd) > 0;
+    auto& wait_list = waiting_fds_[fd];
+    wait_list.push_back(coroutine);
+    extra.push_back(fd);
+#if CO_POLL_MODE == CO_POLL_EPOLL
+    if (epoll_fd_ != -1) {
+      struct epoll_event ev;
+      ev.data.fd = fd;
+      ev.events = 0;
+      if (event_mask & POLLIN) ev.events |= EPOLLIN | EPOLLRDHUP;
+      if (event_mask & POLLOUT) ev.events |= EPOLLOUT;
+      int ret = epoll_ctl(epoll_fd_, fd_already_tracked ? EPOLL_CTL_MOD
+                                                        : EPOLL_CTL_ADD,
+                          fd, &ev);
+      if (ret == -1 && errno == EEXIST) {
+        epoll_ctl(epoll_fd_, EPOLL_CTL_MOD, fd, &ev);
+      }
+    }
+#endif
+  }
+  if (extra.empty()) {
+    extra_fds_.erase(coroutine);
+  }
+}
