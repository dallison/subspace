+TEST(Cpp20, WaitAnyReturnsReadyFd) {
+  Scheduler sched;
+  int a[2];
+  int b[2];
+  ASSERT_EQ(0, pipe(a));
+  ASSERT_EQ(0, pipe(b));
+
+  int result = -1;
+  sched.Spawn([&](Coroutine& co) -> Task {
+    result = co_await co.Wait(std::vector<int>{a[0], b[0]}, POLLIN);
+  }, "waiter");
+  sched.Spawn([&](Coroutine& co) -> Task {
+    co_await co.Sleep(std::chrono::milliseconds(10));
+    char c = 'x';
+    (void)write(b[1], &c, 1);
+  }, "writer");
+
+  sched.Run();
+  EXPECT_EQ(b[0], result);
+  close(a[0]);
+  close(a[1]);
+  close(b[0]);
+  close(b[1]);
+}
+
