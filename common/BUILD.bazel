package(default_visibility = ["//visibility:public"])

load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("//:max_channels.bzl", "max_channels_setting")
load("//:max_buffers.bzl", "max_buffers_setting")
load("//:max_slot_owners.bzl", "max_slot_owners_setting")
load("//:coroutine_stack_size.bzl", "coroutine_stack_size_setting")
load(":slot_owner_layout.bzl", "slot_owner_limit_test")

max_channels_setting(
    name = "max_channels_setting",
)

max_slot_owners_setting(
    name = "max_slot_owners_setting",
)

max_buffers_setting(
    name = "max_buffers_setting",
)

coroutine_stack_size_setting(
    name = "coroutine_stack_setting",
)

cc_library(
    name = "coroutine_stack",
    hdrs = ["coroutine_stack.h"],
    deps = [":coroutine_stack_setting"],
)

cc_library(
    name = "subspace_common",
    srcs = [
        "channel.cc",
        "split_buffer.cc",
        "system_info.cc",
        "syscall_shim.cc",
    ],
    hdrs = [
        "atomic_bitset.h",
        "channel.h",
        "client_buffer.h",
        "fast_ring_buffer.h",
        "split_buffer.h",
        "system_info.h",
        "syscall_shim.h",
        "syscall_shim_test_helper.h",
    ],
    linkopts = select({
        "//:macos_x86_64": [],
        "//:macos_arm64": [],
        "//:macos_default": [],
        "//:android": ["-llog"],
        "//:qnx": ["-lsocket"],
        "//conditions:default": ["-lrt"],
    }),
    deps = [
        ":max_channels_setting",
        ":max_buffers_setting",
        ":max_slot_owners_setting",
        "//proto:subspace_cc_proto",
        "@abseil-cpp//absl/container:flat_hash_map",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/strings:str_format",
        "@protobuf//:protobuf",
        "@coroutines//:co",
        "@cpp_toolbelt//toolbelt",
    ],
)

cc_test(
    name = "common_test",
    size = "small",
    srcs = [
        "atomic_bitset.h",
        "common_test.cc",
        "fast_ring_buffer.h",
    ],
    deps = [
        ":subspace_common",
        "@abseil-cpp//absl/container:flat_hash_set",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "split_buffer_test",
    size = "small",
    srcs = ["split_buffer_test.cc"],
    deps = [
        ":subspace_common",
        "@googletest//:gtest_main",
    ],
)

# Compiled only through :slot_owner_layout_256_test, which sets
# --//:max_slot_owners=256. manual keeps //... from building this source at
# the default count, where its 256-owner checks would not apply.
cc_test(
    name = "slot_owner_layout_256_test_impl",
    size = "small",
    srcs = ["slot_owner_layout_test.cc"],
    tags = ["manual"],
    deps = [
        ":subspace_common",
        "@googletest//:gtest_main",
    ],
    data = [
        "//rust_client:subspace_client_rust",
    ],
)

slot_owner_limit_test(
    name = "slot_owner_layout_256_test",
    size = "small",
    slot_owners = "256",
    target = ":slot_owner_layout_256_test_impl",
)
