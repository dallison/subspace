module(
    name = "subspace",
    version = "3.3.0",
)

# Downstream modules raise build limits next to their bazel_dep.  See
# docs/max-channels.md, docs/max-slot-owners.md, docs/max-buffers.md, and
# docs/coroutine-stack-size.md.
# Defaults: 1024 channels, 1024 slot owners, 341 buffer segments (4 KiB BCB),
# 64 KiB server coroutine stacks.
subspace = use_extension("//:extensions.bzl", "subspace")
use_repo(subspace, "subspace_max_channels")

bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "abseil-cpp", version = "20250814.1")

# Only linked when the server is built with --//:mtls.  See docs/mtls.md.
bazel_dep(name = "boringssl", version = "0.20261020.0")
bazel_dep(name = "googletest", version = "1.17.0.bcr.2")
bazel_dep(name = "protobuf", version = "33.4")

# Phaser 3.1.1 asks for protobuf 34.1 and overrides rules_android to 0.7.2
# so that toolchain resolves on Bazel 9. The clients still build against
# protobuf 33.4, which this module forces.
single_version_override(
    module_name = "protobuf",
    version = "33.4",
)

bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "rules_java", version = "9.1.0")
bazel_dep(name = "rules_pkg", version = "1.0.1")
bazel_dep(name = "rules_android_ndk", version = "0.1.5")
bazel_dep(name = "zlib", version = "1.3.1.bcr.5")
bazel_dep(name = "coroutines", version = "3.4.1")
bazel_dep(name = "cpp_toolbelt", version = "2.1.6")
bazel_dep(name = "phaser", version = "3.1.1")

# retro 1.1.0 and phaser 3.1.1 are not in the BCR yet; pin them below.
bazel_dep(name = "retro", version = "1.1.0")
bazel_dep(name = "rules_python", version = "1.9.0")

git_override(
    module_name = "phaser",
    # Tag 3.1.1.
    commit = "4b3a80c0c90d51e04d4b27aa8cc32b884f2b6e38",
    remote = "https://github.com/dallison/phaser.git",
)

git_override(
    module_name = "retro",
    commit = "6d07c80e58aa0549dde3d1e8862aa99585f8602f",
    remote = "https://github.com/dallison/retro.git",
)

# Boost (for asio_rpc)
bazel_dep(name = "boost.asio", version = "1.87.0.bcr.1")
bazel_dep(name = "boost.context", version = "1.87.0")
bazel_dep(name = "boost.coroutine", version = "1.87.0")
bazel_dep(name = "rules_shell", version = "0.8.0")
bazel_dep(name = "rules_proto", version = "6.0.2")

single_version_override(
    module_name = "boost.asio",
    patch_strip = 1,
    patches = ["//patches:boost_asio_android_pthread.patch"],
)

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    configure_coverage_tool = True,
    is_default = True,
    python_version = "3.11.1",
)

bazel_dep(name = "pybind11_bazel", version = "3.0.1")

# Rust support
bazel_dep(name = "rules_rust", version = "0.74.0")

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2021",
    versions = ["1.85.0"],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//rust_client:Cargo.lock",
    manifests = ["//rust_client:Cargo.toml"],
)

# cargo-bazel maps getrandom's macOS libc dep to aarch64-apple-darwin only; x86_64 (Intel) Darwin
# falls through to empty deps but the same sources still use libc (getentropy, errno).
crate.annotation_select(
    crate = "getrandom",
    repositories = ["crates"],
    triples = [
        "x86_64-apple-darwin",
        "i686-apple-darwin",
    ],
    version = "0.4.1",
    deps = ["@crates__libc-0.2.182//:libc"],
)
use_repo(crate, "crates")

# Android NDK toolchain for cross-compilation.
android_ndk_repository_extension = use_extension(
    "@rules_android_ndk//:extension.bzl",
    "android_ndk_repository_extension",
)
use_repo(android_ndk_repository_extension, "androidndk")
