soong_namespace {}

// Common defaults for all subspace native modules.
cc_defaults {
    name: "subspace_defaults",
    # Add "-DSUBSPACE_MAX_CHANNELS=N", "-DSUBSPACE_MAX_SLOT_OWNERS=N", and/or
    # "-DSUBSPACE_MAX_BUFFERS=N" to cflags to raise build limits.  max_channels
    # N must be a positive multiple of 64; max_slot_owners and max_buffers must
    # be positive integers (max_buffers defaults to 341 for a 4 KiB BCB).
    # Every client built against this library must use the same values.
    # "-DSUBSPACE_COROUTINE_STACK_SIZE=N" sets the server and shadow coroutine
    # stack in bytes (default 65536, a positive multiple of 4096).  Clients do
    # not need to match it.
    cflags: [
        "-std=c++17",
        "-Wall",
        "-Wextra",
        "-Wno-sign-compare",
        "-Wno-missing-field-initializers",
        "-Wno-unused-parameter",
    ],
    target: {
        android: {
            cflags: ["-DSUBSPACE_ANDROID"],
        },
    },
    cppflags: ["-fexceptions"],
    local_include_dirs: ["."],
    include_dirs: ["external/subspace"],
    rtti: true,
    stl: "c++_shared",
    min_sdk_version: "28",
    compile_multilib: "64",
}

// Generate C++ protobuf sources from subspace.proto.
cc_library_static {
    name: "libsubspace_proto",
    defaults: ["subspace_defaults"],
    srcs: ["proto/subspace.proto"],
    proto: {
        type: "full",
        canonical_path_from_root: false,
        include_dirs: ["external/protobuf/src"],
        export_proto_headers: true,
    },
    shared_libs: ["libprotobuf-cpp-full"],
    export_shared_lib_headers: ["libprotobuf-cpp-full"],
    rtti: false,
}
